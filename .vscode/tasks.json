{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "go build -o tradez.exe .",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": "$go"
    },
    {
      "label": "run",
      "type": "shell",
      "command": "go run .",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": "$go"
    },
    {
      "label": "build and run",
      "type": "shell",
      "command": "go build -o tradez.exe . && .\\tradez.exe",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": "$go",
      "dependsOn": []
    },
    {
      "label": "tidy",
      "type": "shell",
      "command": "go mod tidy",
      "group": "none",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "vet",
      "type": "shell",
      "command": "go vet ./...",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$go"
    }
  ]
}
